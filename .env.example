# API 基础路径（开发时指向本地后端或 Mock 服务）
NEXT_PUBLIC_API_URL=/api

# ── 搭一搭 · AI 服务配置 ──
# 硅基流动 — 衣服识别 (Qwen-VL)
SILICONFLOW_API_KEY=
# DeepSeek — 穿搭推荐 + 衣柜分析
DEEPSEEK_API_KEY=
# 阿里百炼 — 备选识别 + 文案生成
DASHSCOPE_API_KEY=
AI_COMMENT_PROVIDER=aliyun-bailian
AI_COMMENT_MODEL=qwen-flash
AI_COMMENT_TIMEOUT_MS=5000

# ── 天气服务 ──
# 和风天气 API Key (dev.qweather.com)
QWEATHER_API_KEY=

# ── 微信小程序 ──
WECHAT_APPID=
WECHAT_SECRET=

# ── 数据库 ──
DATABASE_URL=postgresql://localhost:5432/d1d

# ── 图片存储 ──
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ── 微信云函数 · 衣物资产 Pipeline V2 ──
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_ROUTER_MODEL=qwen3-vl-flash
BAILIAN_DETECTION_MODEL=qwen3-vl-flash
BAILIAN_ATTRIBUTE_MODEL=qwen3-vl-flash
# 实验变量：当前仅用于百炼视觉提示词检测，不代表已稳定接入 aitryon 专用 parsing API。
BAILIAN_TRYON_PARSING_MODEL=aitryon-parsing-v1
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_REGION=cn-shanghai
ALIYUN_SEGMENT_CLOTH_ENDPOINT=https://imageseg.cn-shanghai.aliyuncs.com
ALIYUN_SEGMENT_COMMODITY_ENDPOINT=https://imageseg.cn-shanghai.aliyuncs.com
OSS_REGION=oss-cn-shanghai
# 标准变量；历史兼容变量为 ALIYUN_OSS_USE_SIGNED_URL。未配置时默认 false。
OSS_USE_SIGNED_URL=false
ALIYUN_OSS_USE_SIGNED_URL=
AI_TIMEOUT_MS=30000
AI_MAX_RETRY=1
ASSET_PIPELINE_VERSION=v2
