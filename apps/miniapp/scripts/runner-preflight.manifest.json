{
  "schemaVersion": "d1d-runner-preflight-manifest-v1",
  "auditStatus": "snapshot-aware-clean-state-and-precise-reset",
  "entrypoints": {
    "cmd": "apps/miniapp/scripts/run-sport-windows-acceptance.cmd",
    "powershell": "apps/miniapp/scripts/run-sport-windows-acceptance.ps1",
    "runner": "apps/miniapp/scripts/recommendation-v6-e2e.cjs",
    "captureHelper": "apps/miniapp/scripts/windows-devtools-capture.ps1"
  },
  "staticFindings": {
    "argv": {
      "cmd": ["%*"],
      "powershell": ["--preflight-only"],
      "runner": ["--preflight-only"]
    },
    "processEnvReads": [
      "EVIDENCE_DIR",
      "MINIPROGRAM_AUTOMATOR_PATH",
      "EVIDENCE_ONLY",
      "PRESENTATION_EVIDENCE_ONLY",
      "CAPTURE_PRESENTATION_EVIDENCE",
