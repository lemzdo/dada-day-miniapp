    "preRequestFailureBranches": [
      "CAPTURE_HELPER_MISSING",
      "RUNNER_MISSING",
      "DEVTOOLS_LISTENER_NOT_FOUND",
      "DEVTOOLS_WINDOW_INVALID",
      "SCREENSHOT_PROVIDER_MISMATCH",
      "SCREENSHOT_INVALID",
      "DEVTOOLS_CONNECT_FAILED",
      "TODAY_PAGE_NAVIGATION_FAILED",
      "TODAY_PAGE_UNAVAILABLE",
      "TODAY_PAGE_UNREADABLE",
      "PRECONDITION_NOT_CLEAN",
      "PRECONDITION_HOOK_NOT_FRESH",
      "CAPTURE_HOOK_RESTORE_FAILED",
      "CAPTURE_HOOK_INSTALL_FAILED",
      "CAPTURE_NO_AVAILABLE_TARGET"
