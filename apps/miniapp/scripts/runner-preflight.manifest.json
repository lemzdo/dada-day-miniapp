      "SCREENSHOT_PROVIDER"
      ,"AUTOMATOR_WS_ENDPOINT"
      ,"D1D_RUNNER_RESOLVED_CONFIG_JSON"
    ],
    "powershellEnvWrites": [
      "EVIDENCE_DIR",
      "D1D_DEVTOOLS_HWND",
      "SCREENSHOT_PROVIDER",
      "CAPTURE_PRESENTATION_EVIDENCE",
      "D1D_RUNNER_RESOLVED_CONFIG_JSON",
      "MINIPROGRAM_AUTOMATOR_PATH"
    ],
    "runnerConfigInvalidBranches": [
      "RUNNER_ARGUMENT_INVALID",
      "CONFIG_BOOLEAN_INVALID",
      "CONFIG_PATH_INVALID",
      "AUTOMATOR_PATH_FORMAT_INVALID",
      "AUTOMATOR_MODULE_NOT_RESOLVED",
      "AUTOMATOR_PACKAGE_JSON_INVALID",
      "AUTOMATOR_PACKAGE_NAME_INVALID",
      "AUTOMATOR_PACKAGE_VERSION_INVALID",
      "AUTOMATOR_MODULE_UNLOADABLE",
      "AUTOMATOR_CONNECT_EXPORT_MISSING",
      "WINDOW_HANDLE_CONFLICT",
      "WINDOW_HANDLE_REQUIRED",
      "WINDOW_HANDLE_INVALID",
