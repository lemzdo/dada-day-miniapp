{
  "name": "starter-template",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "format": "prettier --write .",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "cloud:deploy": "node apps/miniapp/scripts/cloud-deploy.js",
    "cloud:deploy:audit": "node apps/miniapp/scripts/cloud-deploy-audit.js",
    "cloud:deploy:lint": "node apps/miniapp/scripts/cloud-deploy-lint.js",
    "cloud:deploy:test": "node --test apps/miniapp/scripts/cloud-deploy.test.js apps/miniapp/scripts/cloud-artifact-contract.test.js apps/miniapp/scripts/check-recommendation-artifacts.test.js apps/miniapp/scripts/check-generate-outfit-package.test.js apps/miniapp/scripts/deployment-contract-lite.test.js",
    "devtools:health": "node apps/miniapp/scripts/devtools-acceptance.js health",
    "today:hot:accept": "node apps/miniapp/scripts/devtools-acceptance.js today-hot",
    "devtools:acceptance:test": "node --test apps/miniapp/scripts/devtools-acceptance.test.js",
    "first-card:smoke": "node apps/miniapp/scripts/first-card-ai-smoke/runner.js --live",
    "first-card:smoke:test": "node --test apps/miniapp/scripts/first-card-ai-smoke/runner.test.js",
    "first-card:production-smoke": "node apps/miniapp/scripts/production-first-card-smoke/runner.js --live",
    "first-card:production-smoke:test": "node --test apps/miniapp/scripts/production-first-card-smoke/*.test.js",
    "first-card:production-smoke:compare": "node apps/miniapp/scripts/production-first-card-smoke/compare.js",
    "first-card:model-race": "node apps/miniapp/scripts/homepage-first-card-model-race/runner.js --live",
    "first-card:model-race:test": "node --test apps/miniapp/scripts/homepage-first-card-model-race/runner.test.js"
  },
  "devDependencies": {
    "@cloudbase/cli": "3.8.1",
    "@eslint/js": "^9.15.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "turbo": "^2.4.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
